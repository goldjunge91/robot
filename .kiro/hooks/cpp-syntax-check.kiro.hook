{
  "enabled": true,
  "name": "C++ Syntax Check",
  "description": "Automatically performs syntax checking on C++ files in the drive_arduino directory when they are modified",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "drive_arduino/**/*.cpp",
      "drive_arduino/**/*.h",
      "drive_arduino/**/*.hpp"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Please perform a syntax check on the modified C++ files in the drive_arduino directory. Check for common syntax errors, missing semicolons, unmatched braces, incorrect header includes, and basic C++ compilation issues. Provide clear feedback on any syntax problems found and suggest fixes."
  }
}