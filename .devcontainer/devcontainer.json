{
    "name": "ROS 2 Development Container (Windows)",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            // Ein Standardbenutzer wird im Dockerfile erstellt.
            "USERNAME": "ros"
        }
    },

    // Führt den Container mit vollen Systemrechten aus, nützlich für den Zugriff auf Hardware.
    "privileged": true,

    // Der Benutzer, als der VS Code im Container ausgeführt wird.
    "remoteUser": "ros",

    // Der Arbeitsbereich im Container.
    "workspaceFolder": "/home/ws",

    // Bindet den lokalen Projektordner in den Arbeitsbereich des Containers ein.
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",

    // Umgebungsvariablen, die im Container gesetzt werden.
    "containerEnv": {
        // Leitet GUI-Anwendungen an den X-Server auf dem Windows-Host weiter.
        "DISPLAY": "host.docker.internal:0.0",
        "ROS_LOCALHOST_ONLY": "1",
        "ROS_DOMAIN_ID": "42"
    },

    // Zusätzliche Argumente für den 'docker run' Befehl.
    "runArgs": [
        // Erleichtert die ROS-Kommunikation und GUI-Weiterleitung.
        "--net=host",
        "--pid=host",
        "--ipc=host"
    ],

    // Einhängepunkte (Mounts) für den Container. Linux-spezifische Mounts wurden entfernt.
    "mounts": [],

    // Befehl, der nach dem Erstellen des Containers ausgeführt wird.
    "postCreateCommand": "sudo rosdep update && sudo rosdep install --from-paths src --ignore-src -y && sudo chown -R $(whoami) /home/ws/",

    // VS Code spezifische Anpassungen.
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    }
}
